{
  "name": "posle-edy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=24.0.0"},
  "scripts": {
    "dev": "vite",
    "dev:full": "node --disable-warning=ExperimentalWarning server/dev.ts",
    "test:api": "node --disable-warning=ExperimentalWarning --test server/api.test.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/model.test.ts",
    "build": "vite build",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --grep @screen"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "chart.js": "^4.6.1",
    "lucide-react": "^0.562.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
